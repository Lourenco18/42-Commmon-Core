# ============================================================================
#  Environment variables — non-secret configuration only.
#  Real credentials live in ../secrets/*.txt and are mounted as Docker
#  secrets (see docker-compose.yml), never stored here.
# ============================================================================

# --- Replace with your own 42 login, must match the Makefile's LOGIN ------
LOGIN=yourlogin
DOMAIN_NAME=yourlogin.42.fr

# --- Ports (kept configurable so a service's port can be changed live -----
# --- during the defense, then `make re` without touching any code) --------
NGINX_PORT=443
WP_FPM_PORT=9000
DB_PORT=3306

# --- MariaDB ---------------------------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user

# --- WordPress ---------------------------------------------------------------
WP_TITLE=Inception
# Admin username must NOT contain admin/Admin/administrator/Administrator
WP_ADMIN_USER=supervisor_le
WP_ADMIN_EMAIL=admin@yourlogin.42.fr
WP_USER=johndoe
WP_USER_EMAIL=johndoe@yourlogin.42.fr
