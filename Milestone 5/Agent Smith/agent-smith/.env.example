# Copy this file to .env and fill in real values for a LIVE run against a real LLM.
# `make test` and the exam_*.sh scripts work perfectly well WITHOUT this file
# (they fall back to the offline DummyProvider + bundled fixture scripts).
#
# Multiple keys per provider are supported for rotation under rate limits:
# add _2, _3, ... suffixes.

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_KEY_2=sk-or-v1-...

# Optionally point at a different OpenAI-compatible provider entirely:
# TOGETHER_API_KEY=...
# GROQ_API_KEY=...

MODEL_NAME=qwen/qwen3-235b-a22b-2507
PROVIDER_URL=https://openrouter.ai/api/v1
