DATA_RAW       = data/raw
VLLM_DIR       = $(DATA_RAW)/vllm-0.10.1
VLLM_ZIP       = vllm-0.10.1.zip
DATASETS_ZIP   = datasets_public.zip
DATASETS_SRC   = datasets_public/public
DS_ANSWERED    = data/datasets/AnsweredQuestions
DS_UNANSWERED  = data/datasets/UnansweredQuestions
INDEX_DIR      = data/processed/bm25_index
OUTPUT_SEARCH  = data/output/search_results
OUTPUT_ANSWERS = data/output/search_results_and_answer
MAX_CHUNK       = 2000
K              = 10

.PHONY: install run debug clean clean-cache deep-clean lint \
        prepare index  answer_dataset  \
        exam-retrieval exam-answer exam-edge-cases  \
        _stage-eval-materials

install:
	rm -rf .venv uv.lock
	uv venv
	uv sync

run:
	uv run python -m student

debug:
	uv run python -m pdb -m student

prepare:
	@echo "==> Creating data directories..."
	@mkdir -p $(DATA_RAW) $(DS_ANSWERED) $(DS_UNANSWERED) \
	          $(OUTPUT_SEARCH) $(OUTPUT_ANSWERS)
	@echo "==> Extracting vLLM repository..."
	@if [ -d "$(VLLM_DIR)" ]; then \
		echo "    $(VLLM_DIR) already exists, skipping unzip."; \
	elif [ -f "$(VLLM_ZIP)" ]; then \
		unzip -q "$(VLLM_ZIP)" -d "$(DATA_RAW)"; \
		echo "    Extracted to $(VLLM_DIR)"; \
	else \
		echo "    ERROR: $(VLLM_ZIP) not found."; \
		echo "    Copy vllm-0.10.1.zip to $(DATA_RAW)/ or set VLLM_ZIP=<path>"; \
		exit 1; \
	fi
	@echo "==> Extracting public datasets..."
	@if [ -d "$(DATASETS_SRC)" ]; then \
		echo "    $(DATASETS_SRC) already exists, skipping unzip."; \
	elif [ -f "$(DATASETS_ZIP)" ]; then \
		unzip -o -q "$(DATASETS_ZIP)" -d .; \
		echo "    Extracted $(DATASETS_ZIP)"; \
	else \
		echo "    NOTE: $(DATASETS_ZIP) not found and $(DATASETS_SRC) doesn't"; \
		echo "    exist either — will look for the datasets anyway below."; \
	fi
	@echo "==> Copying datasets..."
	@SRC=$$(if [ -d "$(DATASETS_SRC)/AnsweredQuestions" ]; then echo "$(DATASETS_SRC)"; \
		else find . -maxdepth 4 -type d -name AnsweredQuestions -not -path "*private*" \
			2>/dev/null | head -1 | xargs -I{} dirname {} 2>/dev/null; fi); \
	if [ -n "$$SRC" ] && [ -d "$$SRC/AnsweredQuestions" ]; then \
		cp "$$SRC"/AnsweredQuestions/*.json $(DS_ANSWERED)/; \
		cp "$$SRC"/UnansweredQuestions/*.json $(DS_UNANSWERED)/; \
		echo "    Datasets copied from $$SRC"; \
	else \
		echo "    WARNING: could not find AnsweredQuestions/UnansweredQuestions."; \
		echo "    Set DATASETS_SRC=<path to public dataset folder> or copy"; \
		echo "    the JSONs into $(DS_ANSWERED)/ and $(DS_UNANSWERED)/ manually."; \
	fi
	@echo "==> Staging private datasets for exam scripts (local rehearsal only)..."
	@$(MAKE) --no-print-directory _stage-eval-materials
	@echo "==> Done. Run 'make index' next."

_stage-eval-materials:
	@if [ -f moulinette_pkg.zip ] && \
	   [ -z "$$(find . -maxdepth 4 -name moulinette-ubuntu 2>/dev/null)" ]; then \
		unzip -o -q moulinette_pkg.zip -d .; \
		echo "    Extracted moulinette_pkg.zip"; \
	fi
	@if [ -f exams.zip ] && \
	   [ -z "$$(find . -maxdepth 6 -name exam_retrieval.sh 2>/dev/null)" ]; then \
		unzip -o -q exams.zip -d .; \
		echo "    Extracted exams.zip"; \
	fi
	@if [ -f datasets_private.zip ] && \
	   [ -z "$$(find . -maxdepth 4 -type d -path '*private/AnsweredQuestions' 2>/dev/null)" ]; then \
		unzip -o -q datasets_private.zip -d .; \
		echo "    Extracted datasets_private.zip"; \
	fi
	@chmod +x $$(find . -maxdepth 6 \( -name "moulinette-ubuntu" -o \
		-name "moulinette-fedora" -o -name "exam_*.sh" \) \
		2>/dev/null) 2>/dev/null || true
	@SCRIPT=$$(find . -maxdepth 6 -name exam_retrieval.sh 2>/dev/null | head -1); \
	PRIVATE_DIR=$$(find . -maxdepth 4 -type d -path '*private/AnsweredQuestions' \
		2>/dev/null | head -1 | xargs -I{} dirname {} 2>/dev/null); \
	if [ -n "$$SCRIPT" ] && [ -n "$$PRIVATE_DIR" ]; then \
		STAGE_ROOT=$$(cd "$$(dirname "$$SCRIPT")/../.." && pwd); \
		mkdir -p "$$STAGE_ROOT/data/datasets/private/AnsweredQuestions" \
		         "$$STAGE_ROOT/data/datasets/private/UnansweredQuestions"; \
		cp -f "$$PRIVATE_DIR/AnsweredQuestions/"*.json \
			"$$STAGE_ROOT/data/datasets/private/AnsweredQuestions/" 2>/dev/null || true; \
		cp -f "$$PRIVATE_DIR/UnansweredQuestions/"*.json \
			"$$STAGE_ROOT/data/datasets/private/UnansweredQuestions/" 2>/dev/null || true; \
		echo "    Private datasets staged (exam_retrieval.sh will find them)."; \
	else \
		echo "    exams.zip / datasets_private.zip not found — skipping"; \
		echo "    private-dataset staging (fine for official grading, where"; \
		echo "    these aren't part of the repo anyway)."; \
	fi
	@if [ "$$(uname)" = "Darwin" ]; then \
		BIN=$$(find . -maxdepth 6 -name moulinette-ubuntu 2>/dev/null | head -1); \
		if [ -n "$$BIN" ]; then \
			WRAP="$$(dirname "$$BIN")/moulinette-ubuntu.mac-docker-wrapper.sh"; \
			printf '#!/bin/bash\n# Auto-generated by "make prepare" on macOS: the real\n# moulinette-ubuntu is a Linux (ELF) binary and cannot run\n# natively here, so this forwards the exact same call through\n# Docker instead. exam_retrieval.sh passes host-absolute paths\n# (e.g. /Users/you/.../search_results/foo.json) as arguments; those\n# do not exist inside the container, so any argument starting with\n# this project'"'"'s own path is rewritten to its /work-mounted form\n# before being passed through. Requires Docker Desktop to be running.\nHOST_ROOT="%s"\nBIN="%s"\nargs=()\nfor a in "$$@"; do\n  case "$$a" in\n    "$$HOST_ROOT"*) a="/work$${a#$$HOST_ROOT}" ;;\n  esac\n  args+=("$$a")\ndone\nexec docker run --rm --platform linux/amd64 -v "$$HOST_ROOT":/work -w /work ubuntu:24.04 "$$BIN" "$${args[@]}"\n' \
				"$$(pwd)" "$$BIN" > "$$WRAP"; \
			chmod +x "$$WRAP"; \
			echo "    macOS detected: created Docker wrapper at $$WRAP"; \
			echo "    (make exam-retrieval/exam-answer will use it automatically)"; \
		fi; \
	fi

index:
	@echo "==> Indexing vLLM repository (max_chunk_size=$(MAX_CHUNK))..."
	uv run python -m student index \
		--max_chunk_size $(MAX_CHUNK)
	@echo "==> Index complete."

answer_dataset:
	@echo "==> Generating answers for docs dataset..."
	uv run python -m student answer_dataset \
		--student_search_results_path $(OUTPUT_SEARCH)/dataset_docs_public.json \
		--save_directory $(OUTPUT_ANSWERS)
	@echo "==> Generating answers for code dataset..."
	uv run python -m student answer_dataset \
		--student_search_results_path $(OUTPUT_SEARCH)/dataset_code_public.json \
		--save_directory $(OUTPUT_ANSWERS)

lint:
	uv run flake8 src
	uv run mypy src --warn-return-any --warn-unused-ignores --ignore-missing-imports \
	        --disallow-untyped-defs --check-untyped-defs


clean:
	find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name ".mypy_cache" -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name ".pytest_cache" -exec rm -rf {} + 2>/dev/null || true
	find . -name "*.pyc" -delete 2>/dev/null || true

clean-cache: clean
	@echo "==> Clearing project-related caches..."
	@rm -rf .venv
	@rm -rf ~/.cache/uv
	@rm -rf ~/.cache/huggingface
	@rm -rf ~/.cache/pip
	@rm -rf ~/.cache/pip-tools
	@rm -rf ~/.cache/huggingface/hub/models--Qwen* 2>/dev/null || true
	@python -m pip cache purge 2>/dev/null || true
	@uv cache clean 2>/dev/null || true
	@echo "==> Project caches cleared."

deep-clean: clean clean-cache
	rm -rf data
	rm -rf src/student.egg-info
	rm -rf .venv
	rm -rf __MACOSX
	rm -rf datasets_public
	rm -rf exams_pkg
	rm -rf moulinette_pkg
	rm -rf private
	python -m pip cache purge
	uv cache clean
	rm -rf ~/.cache/huggingface

EXAM_DIR := $(shell f=$$(find . -maxdepth 6 -name exam_retrieval.sh 2>/dev/null | head -1); \
	if [ -z "$$f" ]; then f=$$(find ../. -maxdepth 6 -name exam_retrieval.sh 2>/dev/null | head -1); fi; \
	[ -n "$$f" ] && dirname "$$f")
MOULINETTE_BIN := $(shell \
	w=$$(find . -maxdepth 6 -name "moulinette-ubuntu.mac-docker-wrapper.sh" 2>/dev/null | head -1); \
	if [ -z "$$w" ]; then w=$$(find ../. -maxdepth 6 -name "moulinette-ubuntu.mac-docker-wrapper.sh" 2>/dev/null | head -1); fi; \
	if [ -n "$$w" ]; then echo "$$w"; \
	else \
		b=$$(find . -maxdepth 6 -name moulinette-ubuntu 2>/dev/null | head -1); \
		if [ -z "$$b" ]; then b=$$(find ../. -maxdepth 6 -name moulinette-ubuntu 2>/dev/null | head -1); fi; \
		echo "$$b"; \
	fi)

exam-retrieval:
	@if [ ! -f "$(EXAM_DIR)/exam_retrieval.sh" ]; then \
		echo "exam_retrieval.sh not found anywhere under this project or its"; \
		echo "parent directory — skipping. Run 'make prepare' first if you"; \
		echo "have exams.zip; this target is for local rehearsal only."; \
	else \
		"$(EXAM_DIR)/exam_retrieval.sh" \
			--student-path . \
			--moulinette-path "$(MOULINETTE_BIN)" \
			--module-name student; \
	fi

exam-answer:
	@if [ ! -f "$(EXAM_DIR)/exam_answer.sh" ]; then \
		echo "exam_answer.sh not found anywhere under this project or its"; \
		echo "parent directory — skipping. Run 'make prepare' first if you"; \
		echo "have exams.zip; this target is for local rehearsal only."; \
	else \
		"$(EXAM_DIR)/exam_answer.sh" \
			--student-path . \
			--moulinette-path "$(MOULINETTE_BIN)" \
			--module-name student; \
	fi

exam-edge-cases:
	@if [ ! -f "$(EXAM_DIR)/exam_edge_cases.sh" ]; then \
		echo "exam_edge_cases.sh not found anywhere under this project or its"; \
		echo "parent directory — skipping. Run 'make prepare' first if you"; \
		echo "have exams.zip; this target is for local rehearsal only."; \
	else \
		"$(EXAM_DIR)/exam_edge_cases.sh" \
			--student-path . \
			--module-name student; \
	fi